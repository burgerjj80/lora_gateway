# --- App ---
PUBLIC_BASE_URL=https://garmin-bridge.example.com
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# --- Database ---
# Postgres with TimescaleDB extension. Locally: docker compose up -d db
DATABASE_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/garmin_bridge

# --- Provider selection ---
# terra | garmin
WEARABLE_PROVIDER=terra

# --- Terra (fastest path; self-serve at tryterra.co) ---
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_SIGNING_SECRET=

# --- Garmin Health API (fill in after developer.garmin.com approval) ---
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# --- Alerts ---
ALERT_EMAIL_FROM=alerts@a2zwarehouse.example
ALERT_SMTP_URL=smtp://user:pass@smtp.example.com:587
ALERT_SLACK_WEBHOOK=

# --- LoRa correlation ---
# Where the LoRa network server posts uplink events (ChirpStack app-server webhook)
LORA_INGEST_TOKEN=change-me-shared-secret-with-chirpstack

# --- Connect IQ widget ingest (watch posts here directly) ---
# Also set this value in the a2zbridge widget's app settings on the watch.
CONNECTIQ_INGEST_TOKEN=change-me-shared-secret-with-watch
